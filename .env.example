# Copiez ce fichier en ".env" puis remplacez les valeurs.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Clé de signature des sessions (obligatoire : ne gardez pas la valeur par défaut)
JWT_SECRET=remplacez_par_une_longue_valeur_aleatoire

# Clé de chiffrement des messages du chat (obligatoire)
ENCRYPTION_KEY=remplacez_par_une_autre_longue_valeur_aleatoire

# Mot de passe du compte administrateur « root », créé au premier lancement (à définir AVANT le premier démarrage)
ROOT_PASSWORD=choisissez_un_mot_de_passe_solide

# Envoi des invitations par e-mail (optionnel : sans ces valeurs, le code d'invitation est seulement affiché)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
